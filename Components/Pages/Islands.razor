@page "/islands"

<PageTitle>Our Islands</PageTitle>


<section id="islands-header" class="d-flex flex-column justify-content-center align-items-center text-center rounded-4 fg-white px-6 py-12 my-8">
    <h1 class="fs-5xl font-header">The Islands of the Bahamas</h1>
</section>

@for (var i = 0; i < IslandData.All.Count; i++)
{
    var island = IslandData.All[i];

    <article id="island-@i" class="grid grid-cols-2 align-items-center my-12">
        <img src="@island.Image" class="w-100 rounded-4 object-fit-cover island-photo" alt="@island.Name" />

        <div>
            <h2 class="fs-3xl font-header mb-2">@island.Name</h2>
            @if (!string.IsNullOrEmpty(island.Capital))
            {
                <p class="fs-md fw-bold mb-2">
                    <i class="fa-solid fa-map-location-dot fg-warning me-2"></i>Capital: @island.Capital
                </p>
            }
            <p class="fs-lg fg-secondary mb-6">@island.Description</p>

            <ul class="attractions-grid list-unstyled mb-0">
                <p class="fs-md fw-bold mb-2">
                </p>
            </ul>
            <ul class="attractions-grid list-unstyled mb-0">
              <p>Attractions</p>
                @foreach (var attraction in island.Attractions)
                {
                    <li>
                        <i class="fa-solid fa-street-view fg-warning me-2"></i>@attraction
                    </li>
                }
            </ul>
        </div>
    </article>
}

